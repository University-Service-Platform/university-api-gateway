# Copy to .env for local use (never commit .env). Every service URL is optional:
# a service without a URL answers 404 ROUTE_NOT_FOUND until it is connected.

ENVIRONMENT=development

# ---- Upstream services (base URLs, no trailing slash) ----
# Group 5 Identity (also provides the token signing keys)
IDENTITY_SERVICE_URL=http://localhost:8001
# Group 5 Directory
DIRECTORY_SERVICE_URL=http://localhost:8002
# Group 6 facility-resource-service
FACILITY_SERVICE_URL=http://localhost:8081
# Group 6 reservation-service
RESERVATION_SERVICE_URL=http://localhost:8082
# Group 7 service-request-service (default port 8081 clashes with Group 6; run it with SERVER_PORT=8083)
SERVICE_REQUEST_SERVICE_URL=http://localhost:8083
# Group 7 work-order-service (default port 8082 clashes with Group 6; run it with SERVER_PORT=8084)
WORK_ORDER_SERVICE_URL=http://localhost:8084
# Group 8 (not deployed yet)
GROUP8_SERVICE_URL=

# ---- Token verification (defaults follow the Identity Service contract) ----
# Default: IDENTITY_SERVICE_URL/.well-known/jwks.json
# JWKS_URL=
JWT_ISSUER=university-identity-service
JWT_AUDIENCE=university-services-platform
JWKS_CACHE_SECONDS=300

# ---- Browser access ----
# Frontend origins allowed to call the gateway (comma-separated). Not needed when the
# frontend is served from the same origin or through the Vite dev proxy.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Timeouts: free hosting wakes sleeping services in about a minute ----
UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
UPSTREAM_READ_TIMEOUT_SECONDS=90

MAX_REQUEST_BODY_BYTES=10485760
LOG_LEVEL=INFO
